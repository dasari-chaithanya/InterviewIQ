    },
    {
      "page": "/coding/[problemId]/report",
      "regex": "^/coding/([^/]+?)/report(?:/)?$",
      "routeKeys": {
        "nxtPproblemId": "nxtPproblemId"
      },
      "namedRegex": "^/coding/(?<nxtPproblemId>[^/]+?)/report(?:/)?$"
    },
    {
