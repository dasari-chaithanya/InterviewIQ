{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/v1/:path*",
        "destination": "http://localhost:8000/api/v1/:path*",
        "regex": "^/api/v1(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/coding/problems/[problemId]",
      "regex": "^/coding/problems/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPproblemId": "nxtPproblemId"
      },
      "namedRegex": "^/coding/problems/(?<nxtPproblemId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/coding/report/[submissionId]",
      "regex": "^/coding/report/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsubmissionId": "nxtPsubmissionId"
      },
      "namedRegex": "^/coding/report/(?<nxtPsubmissionId>[^/]+?)(?:/)?$"
    },
    {
